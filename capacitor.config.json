{
  "appId": "sg.rhythme.app",
  "appName": "Rhythme",
  "webDir": "www",
  "loggingBehavior": "none",
  "zoomEnabled": true,
  "server": {
    "hostname": "localhost",
    "iosScheme": "capacitor",
    "appStartPath": "/room.html"
  },
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "webContentsDebuggingEnabled": false,
    "handleApplicationNotifications": false,
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
