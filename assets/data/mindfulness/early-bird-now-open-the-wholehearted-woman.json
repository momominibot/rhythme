=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke-width=\"1.5\" stroke=\"var(--color-fg-primary)\" stroke-linecap=\"round\" stroke-linejoin=\"round\" xmlns=\"http://www.w3.org/2000/svg\" class=\"icon-noB79L\"><g><path d=\"M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882\"></path></g></svg></button><button tabindex=\"0\" type=\"button\" class=\"pencraft pc-reset pencraft icon-container view-image buttonBase-GK1x3M\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-maximize2 lucide-maximize-2 icon-noB79L\"><polyline points=\"15 3 21 3 21 9\"></polyline><polyline points=\"9 21 3 21 3 15\"></polyline><line x1=\"21\" x2=\"14\" y1=\"3\" y2=\"10\"></line><line x1=\"3\" x2=\"10\" y1=\"21\" y2=\"14\"></line></svg></button></div></div></div></a></figure></div><p>Sometimes, all we really need is a little space to hear ourselves again.</p><p>From <strong>1–5 October 2026</strong>, I’ll be leading <em>The Wholehearted Woman</em>, a five-day mindfulness retreat near the ancient temples of Angkor in Siem Reap, Cambodia.</p><p>This retreat is an invitation to step away from the many roles we carry — as professionals, partners, mothers, daughters, caregivers and leaders — and reconnect with the human being beneath them all.</p><p>Over five days, we will move through a gentle journey of <strong>Softening, Listening, Clarity, Strength, and Carrying the Light Home</strong>. There will be meditation and mindfulness practices, quiet reflection, time in nature, meaningful conversations, rest, and a special excursion to Angkor.</p><p><em>We are not retreating from life.</em> </p><p>We are creating enough space to see how we have been living, and how we might return to our everyday lives with greater presence, self-compassion and inner steadiness.</p><div class=\"captioned-image-container\"><figure><a class=\"image-link image2 is-viewable-img\" target=\"_blank\" href=\"https://substackcdn.com/image/fetch/$s_!MJP7!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F185e86bb-9451-421e-b337-9711929beae3_1080x1350.jpeg\" data-component-name=\"Image2ToDOM\"><div class=\"image2-inset\"><picture><source type=\"image/webp\" srcset=\"https://substackcdn.com/image/fetch/$s_!MJP7!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F185e86bb-9451-421e-b337-9711929beae3_1080x1350.jpeg 424w, https://substackcdn.com/image/fetch/$s_!MJP7!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F185e86bb-9451-421e-b337-9711929beae3_1080x1350.jpeg 848w, https://substackcdn.com/image/fetch/$s_!MJP7!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F185e86bb-9451-421e-b337-9711929beae3_1080x1350.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!MJP7!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F185e86bb-9451-421e-b337-9711929beae3_1080x1350.jpeg 1456w\" sizes=\"100vw\"><img src=\"https://substackcdn.com/image/fetch/$s_!MJP7!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F185e86bb-9451-421e-b337-9711929beae3_1080x1350.jpeg\" width=\"1080\" height=\"1350\" data-attrs=\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/185e86bb-9451-4